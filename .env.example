# Copy this file to .env and fill in your values
# Never commit .env to git

# OpenAI API key (substitute for Azure OpenAI in production)
OPENAI_API_KEY=sk-your-key-here

# Model to use — gpt-4o is best, gpt-3.5-turbo is cheaper for testing
OPENAI_MODEL=gpt-4o

# Path to local SQLite database file
DB_PATH=data/db/clauseguard.db

# Folder where CN PDFs are stored locally
CN_PDF_FOLDER=data/pdfs/cn

# Folder where MSA PDFs are stored locally
MSA_PDF_FOLDER=data/pdfs/msa
